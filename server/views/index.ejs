<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <%- include('partials/flash') %>
    <section class="hero">
      <h1>Добро пожаловать в BookNook</h1>
      <p>Откройте для себя мир увлекательных историй</p>
      <a href="/catalog" class="btn btn-primary">Перейти к каталогу</a>
    </section>

    <section class="features">
      <h2>Почему выбирают нас</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>Широкий выбор</h3>
          <p>Книги на любой вкус — данные из каталога на сервере</p>
        </div>
        <div class="feature-card">
          <h3>Быстрая доставка</h3>
          <p>Доставка по всей стране за 1–3 дня</p>
        </div>
        <div class="feature-card">
          <h3>Удобная оплата</h3>
          <p>Принимаем распространённые способы оплаты</p>
        </div>
      </div>
    </section>

    <% if (featuredBooks && featuredBooks.length) { %>
    <section class="features">
      <h2>Из каталога</h2>
      <div class="books-grid">
        <% featuredBooks.forEach(function (book) { %>
          <article class="book-card">
            <h3><%= book.title %></h3>
            <p class="author"><%= book.author %></p>
            <p class="price"><%= book.price %> ₽</p>
            <form method="post" action="/cart/add">
              <input type="hidden" name="book_id" value="<%= book.id %>">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="add-to-cart">В корзину</button>
            </form>
          </article>
        <% }); %>
      </div>
    </section>
    <% } %>

    <section class="newsletter">
      <h2>Подпишитесь на рассылку</h2>
      <form method="post" action="/newsletter" class="newsletter-form">
        <input type="email" name="email" placeholder="Ваш email" required maxlength="254" autocomplete="email">
        <button type="submit" class="btn btn-primary">Подписаться</button>
      </form>
    </section>
  </main>
  <footer>
    <p><a href="/admin/login">Админ</a></p>
  </footer>
  <script src="/script.js"></script>
</body>
</html>
