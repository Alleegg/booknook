<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/nav') %>
  <main>
    <%- include('../partials/flash') %>
    <section class="admin-section">
      <h1><%= book ? 'Редактирование книги' : 'Новая книга' %></h1>
      <form method="post" action="<%= formAction %>" class="admin-form wide">
        <div class="form-group">
          <label for="title">Название</label>
          <input type="text" id="title" name="title" required maxlength="255" value="<%= book ? book.title : '' %>">
        </div>
        <div class="form-group">
          <label for="author">Автор</label>
          <input type="text" id="author" name="author" required maxlength="255" value="<%= book ? book.author : '' %>">
        </div>
        <div class="form-group">
          <label for="genre_id">Жанр</label>
          <select id="genre_id" name="genre_id" required>
            <% genres.forEach(function (g) { %>
              <option value="<%= g.id %>" <%= book && String(book.genre_id) === String(g.id) ? 'selected' : '' %>><%= g.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label for="price">Цена (₽)</label>
          <input type="text" id="price" name="price" required inputmode="decimal" value="<%= book ? book.price : '' %>">
        </div>
        <button type="submit" class="btn btn-primary"><%= book ? 'Сохранить' : 'Создать' %></button>
        <a href="/admin/books" class="btn btn-secondary">Отмена</a>
      </form>
    </section>
  </main>
  <footer><a href="/admin/books">К списку</a></footer>
  <script src="/script.js"></script>
</body>
</html>
