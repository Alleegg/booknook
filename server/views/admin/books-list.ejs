<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/nav') %>
  <main>
    <%- include('../partials/flash') %>
    <section class="admin-section">
      <div class="admin-toolbar">
        <h1>Книги (CRUD)</h1>
        <a href="/admin/books/new" class="btn btn-primary">Добавить</a>
        <form method="post" action="/admin/logout" class="inline-form">
          <button type="submit" class="btn btn-secondary">Выйти</button>
        </form>
      </div>
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Автор</th>
            <th>Жанр</th>
            <th>Цена</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% books.forEach(function (b) { %>
            <tr>
              <td><%= b.id %></td>
              <td><%= b.title %></td>
              <td><%= b.author %></td>
              <td><%= b.genre_name %></td>
              <td><%= b.price %> ₽</td>
              <td class="admin-actions">
                <a href="/admin/books/<%= b.id %>/edit" class="btn btn-secondary btn-sm">Изменить</a>
                <form method="post" action="/admin/books/<%= b.id %>/delete" class="inline-form" onsubmit="return confirm('Удалить книгу?');">
                  <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  </main>
  <footer><a href="/">На главную</a></footer>
  <script src="/script.js"></script>
</body>
</html>
