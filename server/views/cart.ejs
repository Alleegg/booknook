<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <%- include('partials/flash') %>
    <section class="cart">
      <h1>Корзина</h1>

      <% if (cartEmpty) { %>
        <div class="empty-cart visible">
          <p>Ваша корзина пуста</p>
          <a href="/catalog" class="btn btn-primary">Перейти в каталог</a>
        </div>
      <% } else { %>
        <div class="cart-container">
          <div class="cart-items">
            <% cartRows.forEach(function (row) { %>
              <div class="cart-item">
                <div class="cart-item-info">
                  <h4><%= row.book.title %></h4>
                  <p class="cart-item-author"><%= row.book.author %></p>
                </div>
                <div class="cart-item-quantity">×<%= row.quantity %></div>
                <div class="cart-item-price"><%= Math.round(row.subtotal) %> ₽</div>
                <div class="cart-item-actions">
                  <form method="post" action="/cart/remove">
                    <input type="hidden" name="book_id" value="<%= row.book.id %>">
                    <button type="submit" class="cart-item-remove" aria-label="Удалить">×</button>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>
          <div class="cart-summary">
            <h3>Итого:</h3>
            <div class="cart-total"><%= Math.round(total) %> ₽</div>
            <form method="post" action="/cart/clear">
              <button type="submit" class="btn btn-secondary">Очистить корзину</button>
            </form>
          </div>
        </div>

        <section class="checkout-block">
          <h2>Оформление заказа</h2>
          <form method="post" action="/orders" class="checkout-form">
            <div class="form-group">
              <label for="name">Имя</label>
              <input type="text" id="name" name="name" required maxlength="200" autocomplete="name">
            </div>
            <div class="form-group">
              <label for="phone">Телефон</label>
              <input type="tel" id="phone" name="phone" required maxlength="50" autocomplete="tel">
            </div>
            <div class="form-group">
              <label for="address">Адрес доставки</label>
              <textarea id="address" name="address" required maxlength="2000"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Подтвердить заказ</button>
          </form>
        </section>
      <% } %>
    </section>
  </main>
  <footer></footer>
  <script src="/script.js"></script>
</body>
</html>
